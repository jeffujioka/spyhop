{
  "manifestVersion": 2,
  "id": "spyhop",
  "name": "Spyhop",
  "version": "0.2.0",
  "description": "AI harness session stats (omp, Claude Code, opencode) for every Orca agent: cost, context, cache and sub-agents, with charts.",
  "engines": {
    "orca": ">=1.4.259"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "spyhop",
        "title": "Spyhop",
        "icon": "bar-chart-3",
        "entry": "src/panel.ts",
        "ui": "html"
      }
    ],
    "commands": [
      {
        "id": "spyhop.show",
        "title": "Spyhop: Show session stats"
      }
    ],
    "keybindings": [
      {
        "command": "spyhop.show",
        "key": "Mod+Alt+Shift+S"
      }
    ],
    "statusBarItems": [
      {
        "id": "spyhop",
        "icon": "bar-chart-3",
        "command": "spyhop.show"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "storage:own"
    }
  ]
}
